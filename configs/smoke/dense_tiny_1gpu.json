{
  "schema_version": 1,
  "name": "dense-tiny-1gpu",
  "description": "Single-GPU stock Megatron/Transformer Engine launch preflight.",
  "upstream": {
    "repository": "https://github.com/NVIDIA/Megatron-LM.git",
    "commit": "5cb6dbb3ed04e6fa11a862d90fe898ac2d3ddfad"
  },
  "cluster": {"nnodes": 1, "gpus_per_node": 1},
  "model": {
    "num_layers": 2,
    "hidden_size": 256,
    "ffn_hidden_size": 688,
    "num_attention_heads": 2,
    "num_query_groups": 2,
    "sequence_length": 128,
    "max_position_embeddings": 128,
    "vocab_size": 4096,
    "normalization": "RMSNorm",
    "position_embedding_type": "rope",
    "rotary_base": 10000,
    "swiglu": true,
    "linear_bias": false,
    "tie_embeddings": true
  },
  "parallel": {
    "tensor_model_parallel_size": 1,
    "pipeline_model_parallel_size": 1,
    "context_parallel_size": 1
  },
  "training": {
    "micro_batch_size": 1,
    "global_batch_size": 2,
    "train_iters": 2,
    "learning_rate": 0.0002,
    "min_learning_rate": 0.00002,
    "weight_decay": 0.1,
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "clip_grad": 1.0,
    "seed": 1234,
    "bf16": true
  },
  "runtime": {
    "transformer_impl": "transformer_engine",
    "attention_backend": "unfused",
    "te_fused_attention": false,
    "te_flash_attention": false,
    "te_unfused_attention": true,
    "distributed_optimizer": false,
    "sequence_parallel": false,
    "overlap_grad_reduce": false,
    "overlap_param_gather": false,
    "mock_data": true,
    "log_interval": 1
  }
}
